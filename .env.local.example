# 当たり検出時に update_status.json を叩いて unopened -> unused に遷移させる。
# 開封処理を飛ばしたクーポンが実際に使えるかは未検証のため、false のままにすること。
#
# src/lib/shunsugu/client.ts の fetchChanceResult から参照される。true にすると、
# 当たり（coupon_code !== null）を検出した場合にのみ実際に叩く。
SHUNPASS_ENABLE_UPDATE_STATUS=false

# Google Tasks 連携で使う OAuth クライアントID。
# 未設定なら結果テーブルの Google Tasks 関連UIが一切描画されないため、実質の機能フラグになる。
#
# client_id は秘密情報ではなくブラウザに露出してよい値のため NEXT_PUBLIC_ を付ける
# （他の変数と違い SHUNPASS_ 前置きにできないのは、Next.js がブラウザ公開変数に
#  NEXT_PUBLIC_ が先頭であることを要求するため）。
#
# 認可は GIS のトークンモデル（ブラウザ完結）で行うため client_secret は使わない。
# リダイレクトURIも不要で、代わりに Google Cloud Console 側の
# 「承認済みの JavaScript 生成元」にアクセス元のオリジンを登録する必要がある
# （手順は README.md を参照）。
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# 本番の公開URL。canonical / sitemap.xml / OGP の絶対URLの基点になる。
# 他の変数と違い「未設定なら出さない」では成立しないため、未設定なら
# https://shunpass.vercel.app にフォールバックする（src/lib/site-config.ts）。
# 独自ドメインに移すときはここを変える。末尾スラッシュは付けても除去される。
# NEXT_PUBLIC_SHUNPASS_SITE_URL=https://shunpass.vercel.app

# Google Search Console の所有権確認（HTMLタグ方式）で発行される content の値。
# meta name="google-site-verification" として出力される。未設定なら meta ごと出ない。
# 秘密情報ではない（HTMLに平文で出るもの）。
# NEXT_PUBLIC_SHUNPASS_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# /about に載せる連絡先とソースコードの公開先。すべて任意で、未設定（または空文字）なら
# 該当セクションを描画しない（src/lib/site-config.ts から参照される）。
#
# NEXT_PUBLIC_ を付けているのはブラウザ側に埋め込むため。値はビルド時に静的置換されるので、
# 変更したら dev サーバーの再起動（本番はビルドし直し）が必要。
#
# メールアドレスは公開ページ上に平文で表示されるためスパム収集の対象になりうる。
# 常用アドレスではなく専用アドレスを設定することを推奨する。
# NEXT_PUBLIC_SHUNPASS_CONTACT_EMAIL=shunpass@example.com
# NEXT_PUBLIC_SHUNPASS_CONTACT_URL=https://example.com/profile
# NEXT_PUBLIC_SHUNPASS_REPOSITORY_URL=https://github.com/<owner>/shunpass
# NEXT_PUBLIC_SHUNPASS_DEVELOPER_URL=https://seizu.dev

# next dev が /_next/* へのアクセスを許可するホスト（カンマ区切り）。
# スマホ実機からカメラスキャンを確認するときに、PC の LAN サブネットを指定する。
# 未設定なら 192.168.*.* と 10.*.*.* にフォールバックするので、通常は設定不要。
# WSL / Hyper-V 経由（172.x）で確認したい場合など、既定で足りないときだけ書く。
#
# ワイルドカードはドット区切りの 1 セグメント単位でのみ効く（192.168.* は不可）。
# 空文字にすると localhost 以外を全部ブロックする既定の挙動に戻せる。
# 変更したら dev サーバーの再起動が必要（next.config.ts の評価時に一度だけ読まれる）。
# SHUNPASS_DEV_ORIGINS=192.168.*.*,10.*.*.*,172.20.*.*
